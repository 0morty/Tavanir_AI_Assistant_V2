# ==============================================================================
# Tavanir AI Assistant V2 - Environment Configuration Template
# ==============================================================================

# Core Settings
STORAGE_BACKEND=local

# TEI / vLLM Service Endpoints
TEI_HOST=localhost
TEI_PORT=8080
TEI_API_KEY=EMPTY

VLLM_HOST=localhost
VLLM_PORT=8000
VLLM_API_KEY=EMPTY

# Embeddings
EMBEDDING_PROVIDER=tei
EMBEDDING_MODEL=google/embedding-gemma-2b
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=512
EMBEDDING_TIMEOUT=30.0

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=7333
QDRANT_GRPC_PORT=7334
QDRANT_API_KEY=tavanir_qdrant_secret_key_2026
QDRANT_PREFER_GRPC=false
QDRANT_HTTPS=false
QDRANT_STORAGE_PATH=./data/qdrant_storage

# Qdrant Collections (ADR-001)
QDRANT_SUGGESTION_COLLECTION=tavanir_suggestion_v1
QDRANT_REGULATORY_COLLECTION=tavanir_regulatory_knowledge_v1

# Qdrant Search & Batch Defaults
QDRANT_BATCH_SIZE=64
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_SPARSE_VECTOR_NAME=sparse

# PostgreSQL Database Settings
POSTGRES_SERVER=localhost
POSTGRES_PORT=7432
POSTGRES_DB=tavanir_db
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_STORAGE_PATH=./data/postgres_storage

# Observability & Logging (OpenObserve / Vector)
OPENOBSERVE_PORT=5080
OPENOBSERVE_ROOT_USER_EMAIL=admin@tavanir.local
OPENOBSERVE_ROOT_USER_PASSWORD=TavanirAdmin2026!
OPENOBSERVE_STORAGE_PATH=./data/openobserve_storage
VECTOR_DATA_PATH=./data/vector_data

LOG_LEVEL=INFO
LOG_FORMAT=console
ENVIRONMENT=development
