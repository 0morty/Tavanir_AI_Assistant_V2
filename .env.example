# ==============================================================================
# Tavanir AI Assistant V2 - Environment Configuration Template
# ==============================================================================

# Core Settings
STORAGE_BACKEND=local

# TEI / vLLM Service Endpoints
TEI_HOST=localhost
TEI_PORT=8080
TEI_API_KEY=EMPTY

VLLM_HOST=localhost
VLLM_PORT=8000
VLLM_API_KEY=EMPTY

# Embeddings
EMBEDDING_PROVIDER=tei
EMBEDDING_MODEL=google/embeddinggemma-300m
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=4
EMBEDDING_TIMEOUT=30.0

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=7333
QDRANT_GRPC_PORT=7334
QDRANT_API_KEY=tavanir_qdrant_secret_key_2026
QDRANT_PREFER_GRPC=false
QDRANT_HTTPS=false
QDRANT_STORAGE_PATH=./data/qdrant_storage

# Qdrant Collections (ADR-001)
QDRANT_SUGGESTION_COLLECTION=tavanir_suggestion_v1
QDRANT_SUGGESTION_ALIAS=tavanir_suggestion_active
QDRANT_REGULATORY_COLLECTION=tavanir_regulatory_knowledge_v1

# Qdrant Search & Batch Defaults
QDRANT_BATCH_SIZE=64
QDRANT_BULK_UPSERT_BATCH_SIZE=256
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_SPARSE_VECTOR_NAME=sparse

# PostgreSQL Database Settings
POSTGRES_SERVER=localhost
POSTGRES_PORT=7432
POSTGRES_DB=tavanir_db
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_STORAGE_PATH=./data/postgres_storage

# Observability & Logging (OpenObserve / Vector)
OPENOBSERVE_PORT=5080
OPENOBSERVE_ROOT_USER_EMAIL=admin@tavanir.local
OPENOBSERVE_ROOT_USER_PASSWORD=TavanirAdmin2026!
OPENOBSERVE_STORAGE_PATH=./data/openobserve_storage
VECTOR_DATA_PATH=./data/vector_data

LOG_LEVEL=INFO
LOG_FORMAT=console
ENVIRONMENT=development

# Security & Service Authentication
API_KEY_NAME=X-API-Key
API_KEY=tavanir_default_secret_api_key_2026

# TEI Cross-Encoder Reranker (BAAI/bge-reranker-v2-m3)
RERANKER_HOST=localhost
RERANKER_PORT=8081
RERANKER_API_KEY=EMPTY
RERANKER_EXPECTED_MODEL_ID=BAAI/bge-reranker-v2-m3
RERANKER_CLIENT_BATCH_SIZE=32
RERANKER_MAX_CONCURRENT_REQUESTS=4
RERANKER_RAW_SCORES=true
RERANKER_TRUNCATE=true
RERANKER_TRUNCATION_DIRECTION=Left
RERANKER_CONNECT_TIMEOUT=1.0
RERANKER_READ_TIMEOUT=3.0
RERANKER_MAX_RETRIES=1
RERANKER_RETRY_BASE_DELAY=0.1
RERANKER_RETRY_MAX_DELAY=0.5
RERANKER_TRUNCATION_RISK_CHAR_THRESHOLD=2000

# ==============================================================================
# MSSQL Source Database (Legacy Production)
# ==============================================================================
MSSQL_SERVER=your_mssql_server_ip_or_host
MSSQL_PORT=1433
MSSQL_USER=your_mssql_username
MSSQL_PASSWORD=your_mssql_password
MSSQL_DATABASE=your_mssql_database_name
MSSQL_BATCH_SIZE=200
MSSQL_QUERY_TIMEOUT=120

# ==============================================================================
# Historical Ingestion Pipeline Defaults
# ==============================================================================
CHECKPOINT_JOB_NAME=historical_suggestion_ingestion
AUTO_SWITCH_ALIAS=true
VALIDATION_PROBE_COUNT=3
