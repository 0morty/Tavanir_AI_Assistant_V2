  "paths": {
    "/api/v1/suggestions/analyze": {
      "post": {
        "tags": [
          "v1",
          "Suggestions"
        ],
        "summary": "Analyze an incoming employee suggestion against historical suggestions",
        "description": "Synchronously executes Tri-Track hybrid Qdrant retrieval, candidate deduplication, cross-encoder reranking, Max-Passage pooling, and PostgreSQL hydration to return partitioned similar suggestion IDs.",
        "operationId": "analyze_suggestion_api_v1_suggestions_analyze_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeSuggestionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse_AnalyzeSuggestionDataResponse_"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API Key"
          },
          "422": {
            "description": "Validation error or domain rule violation"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/api/v1/suggestions/ingest": {
      "post": {
        "tags": [
          "v1",
          "Suggestions"
        ],
        "summary": "Ingest a historical or newly submitted employee suggestion",
        "description": "Synchronously normalizes, chunks, embeds, and stores the suggestion in PostgreSQL and Qdrant vector store.",
        "operationId": "ingest_suggestion_api_v1_suggestions_ingest_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestSuggestionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse_IngestSuggestionDataResponse_"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API Key"
          },
          "422": {
            "description": "Validation error or domain rule violation"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/api/v1/suggestions/{suggestionId}": {
      "put": {
        "tags": [
          "v1",
          "Suggestions"
        ],
        "summary": "Full replacement update for an employee suggestion",
        "description": "Synchronously replaces all core fields of an existing suggestion or restores a soft-deleted suggestion with two-phase concurrency control.",
        "operationId": "update_suggestion_api_v1_suggestions__suggestionId__put",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "suggestionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Unique suggestion identifier",
              "title": "Suggestionid"
            },
            "description": "Unique suggestion identifier"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateSuggestionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse_UpdateSuggestionDataResponse_"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API Key"
          },
          "422": {
            "description": "Validation error or domain rule violation"
          }
        }
      },
      "patch": {
        "tags": [
          "v1",
          "Suggestions"
        ],
        "summary": "Partial update for an employee suggestion",
        "description": "Synchronously overlays non-null fields onto an active suggestion with two-phase concurrency control. Soft-deleted suggestions cannot be patched.",
        "operationId": "patch_suggestion_api_v1_suggestions__suggestionId__patch",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "suggestionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Unique suggestion identifier",
              "title": "Suggestionid"
            },
            "description": "Unique suggestion identifier"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchSuggestionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse_UpdateSuggestionDataResponse_"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API Key"
          },
          "422": {
            "description": "Validation error or domain rule violation"
          }
        }
      },
      "delete": {
        "tags": [
          "v1",
          "Suggestions"
        ],
        "summary": "Soft delete a suggestion and purge its vector chunks",
        "description": "Guards against race conditions via advisory locking, sets is_deleted=True in PostgreSQL, and physically purges vector chunks from Qdrant.",
        "operationId": "delete_suggestion_api_v1_suggestions__suggestionId__delete",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "suggestionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Unique suggestion identifier",
              "title": "Suggestionid"
            },
            "description": "Unique suggestion identifier"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse_DeleteSuggestionDataResponse_"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API Key"
          },
          "422": {
            "description": "Validation error or domain rule violation"
          }
        }
      }
    },
    "/api/v1/suggestions/bulk-delete": {
      "post": {
        "tags": [
          "v1",
          "Suggestions"
        ],
        "summary": "Bulk soft-delete suggestions",
        "description": "Sequentially soft-deletes up to 100 suggestions with per-item error isolation. Returns 200 OK if all succeed, 207 Multi-Status on partial success, or 400 Bad Request if all fail.",
        "operationId": "bulk_delete_suggestions_api_v1_suggestions_bulk_delete_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkDeleteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "401": {
            "description": "Missing or invalid API Key"
          },
          "422": {
            "description": "Validation error or domain rule violation"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/api/v1/mock/reset": {
      "post": {
        "tags": [
          "Mock Administration"
        ],
        "summary": "Reset in-memory mock repository to initial seed state",
        "description": "Clears all mutated suggestion data and repopulates the store with baseline realistic Persian suggestions.",
        "operationId": "reset_mock_state_api_v1_mock_reset_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse_MockResetResponseData_"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
